# Rang e Rosh — Public Environment Configuration
# Copy this file to .env.local and fill in your public values.
# NEVER put your Supabase service_role key, database password, or private API secrets here.

# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (Safe for frontend when Row Level Security is enabled)
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Optional Meta Pixel ID (Leave blank until ready to enable Meta Pixel tracking)
VITE_META_PIXEL_ID=

# Public Canonical Site URL (Used for SEO canonical links, Open Graph, and sitemap reference)
VITE_SITE_URL=https://rangerosh.pk

# Default WhatsApp Order & Contact Numbers (International digits or E.164 format)
VITE_WHATSAPP_NUMBER=+923130888048
VITE_GENERAL_CONTACT=+923130888048
VITE_SHIPPING_CONTACT=+923200300552
VITE_BUSINESS_EMAIL=rangerosh.official@gmail.com
